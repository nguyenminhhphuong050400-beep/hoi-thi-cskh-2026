rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Toàn bộ đọc/ghi diễn ra trong namespace exams/{examId}.
    // Ai cũng có thể ĐỌC (màn hình sân khấu không cần đăng nhập cũng xem được).
    // Chỉ cho phép GHI nếu client đã đăng nhập ẩn danh (auth != null) —
    // ứng dụng tự động đăng nhập ẩn danh ngay khi mở trang.
    //
    // LƯU Ý BẢO MẬT: vì đây là giải pháp không dùng dịch vụ trả phí và không
    // dùng Cloud Functions, các quy tắc này KHÔNG phân biệt được vai trò
    // Admin/Đội thi ở tầng máy chủ (việc phân quyền Admin hiện xử lý bằng mật
    // khẩu ở phía giao diện). Với một hội thi nội bộ, mức bảo vệ này thường
    // là đủ. Nếu cần chặt chẽ hơn, hãy nâng cấp sang Firebase Auth có phân
    // quyền (custom claims) + Cloud Functions để chấm điểm phía máy chủ.
    match /exams/{examId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{document=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
