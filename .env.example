# Sao chép file này thành .env rồi điền thông tin dự án Firebase của bạn
# (Lấy tại: Firebase Console > Project settings > General > Your apps > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mật khẩu đăng nhập Ban tổ chức (tự đặt, không dùng dấu nháy)
VITE_ADMIN_PASSWORD=admin123

# Mã kỳ thi hiện tại (đổi khi muốn tạo kỳ thi hoàn toàn mới, độc lập dữ liệu)
VITE_EXAM_ID=cskh2026
